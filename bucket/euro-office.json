{
    "##": "ltguillaume/schep",
    "version": "9.3.6",
    "description": "Office suite that combines text, spreadsheet, presentation and PDF editors allowing to create, view and edit documents. Portable.",
    "homepage": "https://github.com/Euro-Office/DesktopEditors",
    "license": "AGPL-3.0-only",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Euro-Office/DesktopEditors/releases/download/v9.3.6/Euro-Office-DesktopEditors-9.3.6-0-windows-x64.zip",
            "hash": "1f6a221fec9864956fd4e787b2267668220ab2bc51807685bd15e89493b6d533"
        },
        "arm64": {
            "url": "https://github.com/Euro-Office/DesktopEditors/releases/download/v9.3.6/Euro-Office-DesktopEditors-9.3.6-0-windows-arm64.zip",
            "hash": "3b88a249bf623311cdd32c01675338f6c1604177f539e52c65f2c16bde58002e"
        }
    },
    "bin": "DesktopEditors.exe",
    "shortcuts": [
        [
            "DesktopEditors.exe",
            "Euro-Office"
        ]
    ],
    "post_install": [
        "if (-not (Test-Path \"$Env:LocalAppData\\Euro-Office\\*\")) {",
        "    Remove-Item \"$Env:LocalAppData\\Euro-Office\" 2>$null",
        "    if (-not (Test-Path \"$persist_dir\")) {",
        "        New-Item -ItemType Directory -Path \"$persist_dir\" >$null",
        "    }",
        "    New-DirectoryJunction \"$Env:LocalAppData\\Euro-Office\" \"$persist_dir\" >$null",
        "}"
    ],
    "pre_uninstall": [
        "$data = Get-Item \"$Env:LocalAppData\\Euro-Office\"",
        "if (\"$($data.Target)\" -eq \"$persist_dir\") { $data.Delete() }",
        "if ($cmd -eq 'uninstall') {",
        "    Remove-Item \"HKCU:\\Software\\Euro-Office\" -Force -Recurse",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Euro-Office/DesktopEditors/releases",
        "jsonpath": "$[*].assets[*].browser_download_url",
        "regex": "v([\\d.-]+)/Euro-Office-DesktopEditors-(?<fileversion>[\\d.-]+)-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Euro-Office/DesktopEditors/releases/download/v$version/Euro-Office-DesktopEditors-$matchFileversion-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/Euro-Office/DesktopEditors/releases/download/v$version/Euro-Office-DesktopEditors-$matchFileversion-windows-arm64.zip"
            }
        }
    }
}
