{
    "version": "2.9.3",
    "description": "A disk usage statistics viewer and cleanup tool. Portable.",
    "homepage": "https://windirstat.net",
    "license": "GPL-2.0-only",
    "url": "https://github.com/windirstat/windirstat/releases/download/release%2Fv2.9.3/WinDirStat.7z",
    "hash": "e0509718e588ffae76e93f3db6bebaba48b93fa1b9972275de85876229806977",
    "architecture": {
        "64bit": {
            "extract_dir": "x64"
        },
        "32bit": {
            "extract_dir": "x86"
        },
        "arm64": {
            "extract_dir": "arm64"
        }
    },
    "pre_install": [
        "$contents = '[Options]
AutoElevate=1
DarkMode=1
SampleLargeFiles=1
ShowElevationPrompt=0'",
        "Set-Content -Path \"$dir\\WinDirStat.ini\" -Value $contents"
    ],
    "shortcuts": [
        [
            "WinDirStat.exe",
            "WinDirStat"
        ]
    ],
    "persist": "WinDirStat.ini",
    "post_uninstall": "Remove-Item \"HKCU:\\Software\\WinDirStat\" -Force -Recurse 2>$null",
    "checkver": {
        "url": "https://github.com/windirstat/windirstat/releases",
        "regex": "release/v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/windirstat/windirstat/releases/download/release%2Fv$version/WinDirStat.7z",
        "hash": {
            "url": "$baseurl/WinDirStat-Hashes.txt"
        }
    }
}
